#include <iostream>
#include <vector>
#include <string>
#include <iomanip>
#include <algorithm>
#include <map>

using namespace std;

struct Book
{
    int id;
    string title;
    string author;
    string category;
    int total;
    int available;
    int borrowed;

    Book(int i, string t, string a, string c, int n)
        : id(i),
          title(t),
          author(a),
          category(c),
          total(n),
          available(n),
          borrowed(0)
    {
    }
};

struct BorrowRecord
{
    int bookId;
    string reader;
    int days;

    BorrowRecord(int id, string r, int d)
        : bookId(id), reader(r), days(d)
    {
    }
};

class Library
{
private:
    vector<Book> books;
    vector<BorrowRecord> records;

    Book* findBook(int id)
    {
        for (auto& book : books)
        {
            if (book.id == id)
                return &book;
        }

        return nullptr;
    }

    const Book* findBook(int id) const
    {
        for (const auto& book : books)
        {
            if (book.id == id)
                return &book;
        }

        return nullptr;
    }

    bool bookExists(int id) const
    {
        return findBook(id) != nullptr;
    }

public:

    void addBook()
    {
        int id;
        int total;
        string title;
        string author;
        string category;

        cout << "\n========== 添加图书 ==========\n";

        cout << "图书编号: ";
        cin >> id;

        if (bookExists(id))
        {
            cout << "编号已经存在。\n";
            return;
        }

        cout << "图书名称: ";
        cin >> title;

        cout << "作者: ";
        cin >> author;

        cout << "分类: ";
        cin >> category;

        cout << "馆藏数量: ";
        cin >> total;

        if (total <= 0)
        {
            cout << "馆藏数量必须大于 0。\n";
            return;
        }

        books.emplace_back(
            id,
            title,
            author,
            category,
            total
        );

        cout << "图书添加成功。\n";
    }

    void showBook(const Book& book) const
    {
        cout << left
             << setw(8) << book.id
             << setw(20) << book.title
             << setw(15) << book.author
             << setw(15) << book.category
             << setw(8) << book.total
             << setw(8) << book.available
             << setw(8) << book.borrowed
             << '\n';
    }

    void listBooks() const
    {
        if (books.empty())
        {
            cout << "\n当前没有图书。\n";
            return;
        }

        cout << "\n";
        cout << left
             << setw(8) << "编号"
             << setw(20) << "书名"
             << setw(15) << "作者"
             << setw(15) << "分类"
             << setw(8) << "总数"
             << setw(8) << "可借"
             << setw(8) << "已借"
             << '\n';

        cout << string(82, '-') << '\n';

        for (const auto& book : books)
        {
            showBook(book);
        }
    }

    void searchBook()
    {
        string keyword;
        bool found = false;

        cout << "\n请输入书名、作者或分类: ";
        cin >> keyword;

        cout << "\n搜索结果:\n";
        cout << string(82, '-') << '\n';

        for (const auto& book : books)
        {
            bool match =
                book.title.find(keyword) != string::npos ||
                book.author.find(keyword) != string::npos ||
                book.category.find(keyword) != string::npos;

            if (match)
            {
                showBook(book);
                found = true;
            }
        }

        if (!found)
        {
            cout << "没有找到相关图书。\n";
        }
    }

    void borrowBook()
    {
        int id;
        int days;
        string reader;

        cout << "\n========== 图书借阅 ==========\n";

        cout << "图书编号: ";
        cin >> id;

        Book* book = findBook(id);

        if (book == nullptr)
        {
            cout << "图书不存在。\n";
            return;
        }

        if (book->available <= 0)
        {
            cout << "该图书目前没有可借库存。\n";
            return;
        }

        cout << "读者姓名: ";
        cin >> reader;

        cout << "借阅天数: ";
        cin >> days;

        if (days <= 0)
        {
            cout << "借阅天数必须大于 0。\n";
            return;
        }

        book->available--;
        book->borrowed++;

        records.emplace_back(
            id,
            reader,
            days
        );

        cout << "借阅成功。\n";
        cout << "剩余可借数量: "
             << book->available
             << '\n';
    }

    void returnBook()
    {
        int id;
        string reader;

        cout << "\n========== 图书归还 ==========\n";

        cout << "图书编号: ";
        cin >> id;

        Book* book = findBook(id);

        if (book == nullptr)
        {
            cout << "图书不存在。\n";
            return;
        }

        if (book->borrowed <= 0)
        {
            cout << "该图书当前没有借出记录。\n";
            return;
        }

        cout << "读者姓名: ";
        cin >> reader;

        auto it = find_if(
            records.begin(),
            records.end(),
            [id, &reader](const BorrowRecord& record)
            {
                return record.bookId == id &&
                       record.reader == reader;
            }
        );

        if (it == records.end())
        {
            cout << "没有找到对应借阅记录。\n";
            return;
        }

        book->borrowed--;
        book->available++;

        records.erase(it);

        cout << "归还成功。\n";
    }

    void deleteBook()
    {
        int id;

        cout << "\n请输入要删除的图书编号: ";
        cin >> id;

        Book* book = findBook(id);

        if (book == nullptr)
        {
            cout << "图书不存在。\n";
            return;
        }

        if (book->borrowed > 0)
        {
            cout << "该图书仍有借出记录，不能删除。\n";
            return;
        }

        auto it = remove_if(
            books.begin(),
            books.end(),
            [id](const Book& book)
            {
                return book.id == id;
            }
        );

        books.erase(it, books.end());

        cout << "图书删除成功。\n";
    }

    void modifyBook()
    {
        int id;

        cout << "\n请输入图书编号: ";
        cin >> id;

        Book* book = findBook(id);

        if (book == nullptr)
        {
            cout << "图书不存在。\n";
            return;
        }

        int option;

        cout << "\n1. 修改书名\n";
        cout << "2. 修改作者\n";
        cout << "3. 修改分类\n";
        cout << "4. 修改馆藏数量\n";
        cout << "请选择: ";

        cin >> option;

        switch (option)
        {
        case 1:
        {
            string title;

            cout << "新书名: ";
            cin >> title;

            book->title = title;

            cout << "修改成功。\n";
            break;
        }

        case 2:
        {
            string author;

            cout << "新作者: ";
            cin >> author;

            book->author = author;

            cout << "修改成功。\n";
            break;
        }

        case 3:
        {
            string category;

            cout << "新分类: ";
            cin >> category;

            book->category = category;

            cout << "修改成功。\n";
            break;
        }

        case 4:
        {
            int total;

            cout << "新的馆藏数量: ";
            cin >> total;

            if (total < book->borrowed)
            {
                cout << "馆藏数量不能低于当前借出数量。\n";
                break;
            }

            book->total = total;
            book->available =
                total - book->borrowed;

            cout << "修改成功。\n";
            break;
        }

        default:
            cout << "无效选项。\n";
            break;
        }
    }

    void showBorrowRecords() const
    {
        if (records.empty())
        {
            cout << "\n当前没有借阅记录。\n";
            return;
        }

        cout << "\n========== 借阅记录 ==========\n";

        cout << left
             << setw(10) << "图书编号"
             << setw(20) << "书名"
             << setw(18) << "读者"
             << setw(12) << "借阅天数"
             << '\n';

        cout << string(60, '-') << '\n';

        for (const auto& record : records)
        {
            const Book* book =
                findBook(record.bookId);

            cout << left
                 << setw(10) << record.bookId;

            if (book)
                cout << setw(20) << book->title;
            else
                cout << setw(20) << "未知图书";

            cout << setw(18)
                 << record.reader
                 << setw(12)
                 << record.days
                 << '\n';
        }
    }

    void overdueBooks() const
    {
        bool found = false;

        cout << "\n========== 可能逾期的图书 ==========\n";

        for (const auto& record : records)
        {
            if (record.days > 30)
            {
                const Book* book =
                    findBook(record.bookId);

                if (book)
                {
                    cout << "图书: "
                         << book->title
                         << " | 读者: "
                         << record.reader
                         << " | 借阅: "
                         << record.days
                         << " 天\n";

                    found = true;
                }
            }
        }

        if (!found)
        {
            cout << "当前没有超过 30 天的记录。\n";
        }
    }

    void categoryStatistics() const
    {
        if (books.empty())
        {
            cout << "\n暂无图书数据。\n";
            return;
        }

        map<string, int> counter;

        for (const auto& book : books)
        {
            counter[book.category] += book.total;
        }

        cout << "\n========== 分类统计 ==========\n";

        for (const auto& item : counter)
        {
            cout << left
                 << setw(20)
                 << item.first
                 << "馆藏 "
                 << item.second
                 << " 册\n";
        }
    }

    void sortByTitle()
    {
        sort(
            books.begin(),
            books.end(),
            [](const Book& a, const Book& b)
            {
                return a.title < b.title;
            }
        );

        cout << "已经按照书名排序。\n";
    }

    void sortByAvailable()
    {
        sort(
            books.begin(),
            books.end(),
            [](const Book& a, const Book& b)
            {
                return a.available < b.available;
            }
        );

        cout << "已经按照可借数量排序。\n";
    }

    void sortByBorrowed()
    {
        sort(
            books.begin(),
            books.end(),
            [](const Book& a, const Book& b)
            {
                return a.borrowed > b.borrowed;
            }
        );

        cout << "已经按照借阅数量排序。\n";
    }

    void statistics() const
    {
        int totalBooks = 0;
        int availableBooks = 0;
        int borrowedBooks = 0;

        for (const auto& book : books)
        {
            totalBooks += book.total;
            availableBooks += book.available;
            borrowedBooks += book.borrowed;
        }

        cout << "\n========== 图书馆统计 ==========\n";

        cout << "图书种类: "
             << books.size()
             << '\n';

        cout << "馆藏总量: "
             << totalBooks
             << '\n';

        cout << "当前可借: "
             << availableBooks
             << '\n';

        cout << "当前借出: "
             << borrowedBooks
             << '\n';

        cout << "借阅记录: "
             << records.size()
             << '\n';

        if (totalBooks > 0)
        {
            double rate =
                static_cast<double>(borrowedBooks)
                / totalBooks * 100.0;

            cout << "图书借出率: "
                 << fixed
                 << setprecision(2)
                 << rate
                 << "%\n";
        }

        cout << "================================\n";
    }
};

void showMenu()
{
    cout << "\n";
    cout << "=====================================\n";
    cout << "       C++ 图书馆管理系统\n";
    cout << "=====================================\n";
    cout << "1. 添加图书\n";
    cout << "2. 查看全部图书\n";
    cout << "3. 搜索图书\n";
    cout << "4. 借阅图书\n";
    cout << "5. 归还图书\n";
    cout << "6. 删除图书\n";
    cout << "7. 修改图书\n";
    cout << "8. 查看借阅记录\n";
    cout << "9. 检查逾期记录\n";
    cout << "10. 分类统计\n";
    cout << "11. 按书名排序\n";
    cout << "12. 按库存排序\n";
    cout << "13. 按借阅量排序\n";
    cout << "14. 图书馆统计\n";
    cout << "0. 退出系统\n";
    cout << "=====================================\n";
    cout << "请选择功能: ";
}

void loadDemoData(Library& library)
{
    cout << "\n正在初始化示例数据...\n";

    cout << "提示：可以通过菜单继续添加图书。\n";
}

int main()
{
    Library library;

    loadDemoData(library);

    int choice;

    while (true)
    {
        showMenu();

        cin >> choice;

        if (cin.fail())
        {
            cin.clear();
            cin.ignore(10000, '\n');

            cout << "请输入正确的数字。\n";
            continue;
        }

        switch (choice)
        {
        case 1:
            library.addBook();
            break;

        case 2:
            library.listBooks();
            break;

        case 3:
            library.searchBook();
            break;

        case 4:
            library.borrowBook();
            break;

        case 5:
            library.returnBook();
            break;

        case 6:
            library.deleteBook();
            break;

        case 7:
            library.modifyBook();
            break;

        case 8:
            library.showBorrowRecords();
            break;

        case 9:
            library.overdueBooks();
            break;

        case 10:
            library.categoryStatistics();
            break;

        case 11:
            library.sortByTitle();
            break;

        case 12:
            library.sortByAvailable();
            break;

        case 13:
            library.sortByBorrowed();
            break;

        case 14:
            library.statistics();
            break;

        case 0:
            cout << "\n系统已经退出，感谢使用。\n";
            return 0;

        default:
            cout << "\n无效选项，请重新选择。\n";
            break;
        }
    }

    return 0;
}
